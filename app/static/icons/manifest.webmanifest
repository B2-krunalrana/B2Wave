{
  "name": "B2Wave",
  "short_name": "B2Wave",
  "description": "SMS, calls, voice campaigns and AI calling from your browser",
  "start_url": "/#home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0c11",
